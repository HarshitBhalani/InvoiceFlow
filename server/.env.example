PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/invoiceflow
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
FREE_INVOICE_LIMIT=5
PRO_PRICE_USD=19

# Email (https://resend.com). Without a key, emails are printed to the server console in development.
RESEND_API_KEY=
EMAIL_FROM=InvoiceFlow <onboarding@resend.dev>

# Background jobs (recurring invoices + reminders). Call POST /api/cron/run hourly with header x-cron-secret.
CRON_SECRET=
# DISABLE_INTERNAL_JOBS=true

# Security / deployment
# Shared secret between the Vercel /api proxy and this API (set the SAME value on Vercel). Without it, every visitor
# behind Vercel looks like one IP and shares a single rate limit. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PROXY_SECRET=
# Only if the browser calls the API on a different domain directly (not through the Vercel /api proxy):
# COOKIE_SAMESITE=none
# Password for the seeded admin account. If unset, a random one is generated and printed once.
# SEED_ADMIN_PASSWORD=
